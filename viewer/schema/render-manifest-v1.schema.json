{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/acgetchell/CDT-plusplus/blob/main/viewer/schema/render-manifest-v1.schema.json",
  "title": "CDT++ archival viewer render manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "artifact",
    "fixture",
    "renderer",
    "render",
    "comparison"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "../../schema/render-manifest-v1.schema.json"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "metadata_path",
        "sha256",
        "provenance",
        "expected_topology"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "metadata_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "producer",
            "producer_command",
            "source_revision",
            "topology",
            "dimension",
            "desired_simplices",
            "timeslices",
            "initial_radius",
            "foliation_spacing",
            "seed",
            "threads",
            "fresh_topology_replay_supported",
            "note"
          ],
          "properties": {
            "producer": {
              "type": "string",
              "minLength": 1
            },
            "producer_command": {
              "type": "string",
              "minLength": 1
            },
            "source_revision": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "topology": {
              "type": "string",
              "const": "spherical"
            },
            "dimension": {
              "type": "integer",
              "const": 3
            },
            "desired_simplices": {
              "type": "integer",
              "minimum": 2
            },
            "timeslices": {
              "type": "integer",
              "minimum": 2
            },
            "initial_radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "foliation_spacing": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "threads": {
              "type": "integer",
              "minimum": 1
            },
            "fresh_topology_replay_supported": {
              "type": "boolean",
              "const": false
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected_topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vertices",
            "edges",
            "faces",
            "simplices",
            "minimum_timeslice",
            "maximum_timeslice"
          ],
          "properties": {
            "vertices": {
              "type": "integer",
              "minimum": 1
            },
            "edges": {
              "type": "integer",
              "minimum": 1
            },
            "faces": {
              "type": "integer",
              "minimum": 1
            },
            "simplices": {
              "type": "integer",
              "minimum": 1
            },
            "minimum_timeslice": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_timeslice": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "cgal_version",
        "qt_version",
        "vcpkg_baseline",
        "cmake_version",
        "ninja_version",
        "canonical_platform",
        "canonical_toolchain",
        "graphics_api"
      ],
      "properties": {
        "name": {
          "type": "string",
          "const": "cdt-viewer"
        },
        "cgal_version": {
          "type": "string",
          "minLength": 1
        },
        "qt_version": {
          "type": "string",
          "minLength": 1
        },
        "vcpkg_baseline": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "cmake_version": {
          "type": "string",
          "minLength": 1
        },
        "ninja_version": {
          "type": "string",
          "minLength": 1
        },
        "canonical_platform": {
          "type": "string",
          "minLength": 1
        },
        "canonical_toolchain": {
          "type": "string",
          "minLength": 1
        },
        "graphics_api": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_format",
        "width",
        "height",
        "transparent_background",
        "oversampling",
        "expand_frustum",
        "geometry",
        "camera",
        "style"
      ],
      "properties": {
        "output_format": {
          "type": "string",
          "const": "png"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "transparent_background": {
          "type": "boolean"
        },
        "oversampling": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        },
        "expand_frustum": {
          "type": "boolean"
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vertices",
            "edges",
            "faces",
            "vertex_scope",
            "edge_scope"
          ],
          "properties": {
            "vertices": {
              "type": "boolean"
            },
            "edges": {
              "type": "boolean"
            },
            "faces": {
              "type": "boolean"
            },
            "vertex_scope": {
              "enum": [
                "all",
                "convex_hull"
              ]
            },
            "edge_scope": {
              "enum": [
                "all",
                "screen_space_face_boundaries"
              ]
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projection",
            "position",
            "target",
            "up",
            "vertical_field_of_view_radians"
          ],
          "properties": {
            "projection": {
              "enum": [
                "perspective",
                "orthographic"
              ]
            },
            "position": {
              "$ref": "#/$defs/vector3"
            },
            "target": {
              "$ref": "#/$defs/vector3"
            },
            "up": {
              "$ref": "#/$defs/vector3"
            },
            "vertical_field_of_view_radians": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 3.141592653589793
            }
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "flat_shading",
            "point_size",
            "line_width",
            "edge_color_difference_threshold",
            "point_color_match_tolerance",
            "background_rgba",
            "point_rgba",
            "edge_rgba",
            "face_palette"
          ],
          "properties": {
            "flat_shading": {
              "type": "boolean"
            },
            "point_size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "line_width": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "edge_color_difference_threshold": {
              "type": "integer",
              "minimum": 0,
              "maximum": 765
            },
            "point_color_match_tolerance": {
              "type": "integer",
              "minimum": 0,
              "maximum": 765
            },
            "background_rgba": {
              "$ref": "#/$defs/rgba"
            },
            "point_rgba": {
              "$ref": "#/$defs/rgba"
            },
            "edge_rgba": {
              "$ref": "#/$defs/rgba"
            },
            "face_palette": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rgb"
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_sha256",
        "minimum_file_bytes",
        "minimum_foreground_pixels",
        "portable_policy"
      ],
      "properties": {
        "canonical_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minimum_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "minimum_foreground_pixels": {
          "type": "integer",
          "minimum": 1
        },
        "portable_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "channel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "rgb": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/channel"
        },
        {
          "$ref": "#/$defs/channel"
        },
        {
          "$ref": "#/$defs/channel"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "rgba": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/channel"
        },
        {
          "$ref": "#/$defs/channel"
        },
        {
          "$ref": "#/$defs/channel"
        },
        {
          "$ref": "#/$defs/channel"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    }
  }
}
